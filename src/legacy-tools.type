path = require 'node:path'

createRuntime = (bridge) ->
  qualifiedTool = (folder, name) ->
    return "system.#{name}" unless folder
    if name.startsWith "#{folder}." then name else "#{folder}.#{name}"
  toolOwner = (container, tool, agentFolder) ->
    source = if typeof tool?._file is 'string' then tool._file else agentFolder
    relative = path.relative container.workspace, source
    return null if not relative or relative.startsWith('..') or path.isAbsolute relative
    owner = container.registry.discover().filter((pkg) -> source is pkg.dir or source.startsWith pkg.dir + path.sep).sort((a, b) -> b.dir.length - a.dir.length)[0]
    owner?.folder ? null
  toolToMcp = (container, tool, folder) ->
    provider = if folder then {kind: 'package', id: folder} else bridge.SYSTEM_PRINCIPAL
    container.authority.enforce {principal: provider, surface: 'tools', operation: 'provide', resource: qualifiedTool folder, tool.name}
    name: tool.name
    qualifiedName: qualifiedTool folder, tool.name
    description: tool.description or ''
    inputSchema: tool.parameters or {type: 'object', properties: {}}
    condition: tool.condition or null
    reach: tool.reach or 'auto'
    recoveryPolicy: tool.recoveryPolicy or null
    reconcileTool: tool.reconcileTool or null
    handler: (args, context = bridge.createRuntimeContext()) ->
      caller = bridge.currentAuthority().principal
      container.authority.enforce {principal: caller, surface: 'tools', operation: 'invoke', resource: qualifiedTool folder, tool.name}
      allowed = await bridge.resolveConditions tool.condition or {}, context
      throw new Error "Tool not available in this context: #{tool.name}" unless allowed
      sessionId = context?.sessionId ? null
      gate = await bridge.runAsSystem container.authority, -> container.bus.veto 'tool_before', {tool: tool.name, payload: args, sessionId}, context
      unless gate.allowed
        reason = gate.reason or "Tool blocked by #{gate.by ? 'runtime policy'}: #{tool.name}"
        await bridge.runAsSystem container.authority, -> container.bus.emit 'tool_after', {tool: tool.name, sessionId, payload: {blocked: true, error: reason, code: gate.code}}, context
        err = new Error reason
        err.code = gate.code or 'TOOL_BLOCKED'
        err.blockedBy = gate.by ? null
        err.details = gate.details ? null
        throw err
      execute = ->
        middlewares = await bridge.resolveMiddlewares folder ? container.workspace, context
        bridge.runMiddlewares middlewares, context, -> tool.call args, context
      result = if folder then await bridge.runAsPackage container.authority, folder, execute else await bridge.runAsSystem container.authority, execute
      await bridge.runAsSystem container.authority, -> container.bus.emit 'tool_after', {tool: tool.name, sessionId, payload: result}, context
      result
  kernelTools = (container) ->
    [
      {
        name: 'runtime_commit'
        description: 'Commits pending file changes of a package: validates in staging and swaps atomically if healthy. Use after finishing a multi-file edit.'
        inputSchema: {type: 'object', properties: {package: {type: 'string', description: 'Package folder name'}}, required: ['package']}
        condition: null
        handler: (args) -> container.bus.pipeline 'reload:commit', {pkg: args.package, requestedBy: 'tool'}
      }
      {
        name: 'runtime_activate_package'
        description: 'Safely discovers and activates a package created while the runtime is running. It validates and wires only that package; it never restarts the process.'
        inputSchema: {type: 'object', properties: {package: {type: 'string', description: 'Package folder name'}}, required: ['package']}
        condition: null
        handler: (args) ->
          activate = container.state('runtime').get 'activatePackage'
          return {ok: false, error: 'Package activation is unavailable before runtime initialization.'} unless typeof activate is 'function'
          activate args.package, 'manual'
      }
      {
        name: 'runtime_package_diagnostics'
        description: 'Reports package discovery and activation diagnostics without exposing credentials or source content.'
        inputSchema: {type: 'object', properties: {package: {type: 'string', description: 'Optional package folder name'}}}
        condition: null
        handler: (args) ->
          diagnostics = container.state('runtime').get 'packageDiagnostics'
          return diagnostics args?.package if typeof diagnostics is 'function'
          {workspaceWatcher: false, package: args?.package ? null, state: null, error: 'Runtime diagnostics are unavailable before initialization.'}
      }
      {
        name: 'runtime_reboot_impact'
        description: 'Returns what a FULL runtime restart would cost right now: packages that declare themselves critical (runtime.isolation.critical) and the live WebSocket sessions that would be dropped. Check this before rebooting — reloading a single package (runtime_commit) is almost always enough.'
        inputSchema: {type: 'object', properties: {}}
        condition: null
        handler: ->
          verdict = await bridge.requestReboot container, {reason: 'impact check'}
          {rebootAdvised: verdict.allowed, blockedBy: verdict.blockedBy ? null, criticalPackages: verdict.impact.critical, liveSessions: verdict.impact.liveSessions}
      }
      {
        name: 'runtime_status'
        description: 'Returns the lifecycle state of every package (active, staging, failed, rolled_back) and last reload errors.'
        inputSchema: {type: 'object', properties: {}}
        condition: null
        handler: -> {packages: container.registry.snapshot(), errors: bridge.getErrors().slice(-10)}
      }
      {
        name: 'runtime_manifest'
        description: "Returns a package's capability manifest (tools, hooks, routes, commands) derived from its @register_* JSDoc tags — use to discover what a package offers before wiring it into a crew or flow."
        inputSchema: {type: 'object', properties: {package: {type: 'string', description: 'Package folder name'}}, required: ['package']}
        condition: null
        handler: (args) -> bridge.generateManifest args.package
      }
    ]
  loadMcpTools = (container, agentFolder) ->
    isolated = bridge.getIsolatedRunner container, if path.isAbsolute(agentFolder) then path.relative(container.workspace, agentFolder) else agentFolder
    tools = isolated?.surfaces?.tools.map((tool) -> {...tool, _file: agentFolder, call: (args, context) -> isolated.invoke tool.id, [args], context}) ? await bridge.registerTools agentFolder
    tools.map (tool) ->
      owner = toolOwner container, tool, agentFolder
      principal = if owner then {kind: 'package', id: owner} else bridge.SYSTEM_PRINCIPAL
      container.authority.enforce {principal, surface: 'tools', operation: 'expose', resource: qualifiedTool owner, tool.name}
      toolToMcp container, tool, owner
  toolsModule =
    name: 'tools'
    phase: 'wire'
    install: (container) ->
      container.state('tools').set 'kernel', kernelTools container
      container.bus.on 'tool:call', (payload, ctx) ->
        {package: folder, tool: name, args} = payload or {}
        return {success: false, error: 'package e tool sao obrigatorios'} unless folder and name
        try
          isolated = bridge.getIsolatedRunner container, folder
          tools = isolated?.surfaces?.tools.map((tool) -> {...tool, _file: container.registry.getPackage(folder).dir, call: (input, context) -> isolated.invoke tool.id, [input], context}) ? await bridge.registerTools folder
        catch err
          return {success: false, error: "Pacote \"#{folder}\" nao encontrado: #{err.message}"}
        toolDef = tools.find (tool) -> tool.name is name
        return {success: false, error: "Tool \"#{name}\" nao encontrada no pacote \"#{folder}\""} unless toolDef
        try
          wrapped = toolToMcp container, toolDef, folder
          await wrapped.handler args, ctx ? bridge.createRuntimeContext()
        catch err
          {success: false, error: err.message}
      return
  {toolsModule, toolToMcp, kernelTools, loadMcpTools}
module.exports = {createRuntime}
