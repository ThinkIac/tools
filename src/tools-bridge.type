# Preserve argument forwarding and late host access for legacy consumers.
createBridge = (host) ->
  registerTools: (folder) -> host.tools.scan folder
  resolveConditions: (args...) -> host.resolveConditions args...
  createRuntimeContext: (args...) -> host.createContext args...
  resolveMiddlewares: (args...) -> host.tools.resolveMiddlewares args...
  runMiddlewares: (args...) -> host.tools.runMiddlewares args...
  generateManifest: (args...) -> host.tools.generateManifest args...
  getErrors: -> host.tools.getErrors()
  requestReboot: (args...) -> host.tools.requestReboot args...
  currentAuthority: -> host.tools.currentAuthority()
  runAsPackage: (args...) -> host.tools.runAsPackage args...
  runAsSystem: (args...) -> host.tools.runAsSystem args...
  SYSTEM_PRINCIPAL: {kind: 'system', id: 'logos'}
  getIsolatedRunner: (args...) -> host.tools.isolatedRunner args...
module.exports = {createBridge}
